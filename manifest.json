{
  "manifest_version": 3,
  "name": "Utidio",
  "version": "1.2.1",
  "description": "When media starts in one tab, Utidio pauses media in other tabs. Manage playback and daily listening time from one popup.",
  "minimum_chrome_version": "102",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Utidio — One plays, others pause",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["constants.js", "content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
