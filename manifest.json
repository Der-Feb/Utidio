{
  "manifest_version": 3,
  "name": "Tab Audio Sentinel",
  "version": "1.0",
  "description": "Ensures only one browser tab plays audio at a time and manages media streams.",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["constants.js", "content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
