{
  "manifest_version": 3,
  "name": "Utidio Tab Audio Sentinel",
  "version": "1.0",
  "description": "Ensures only one browser tab plays audio at a time.",
  "permissions": ["tabs", "scripting", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
